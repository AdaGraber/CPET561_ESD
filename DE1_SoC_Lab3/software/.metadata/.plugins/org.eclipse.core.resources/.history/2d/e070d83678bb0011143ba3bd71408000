//includes
#include "io.h"
#include <stdio.h>
#include <stdbool.h>
#include "system.h"
#include "alt_types.h"
#include "sys/alt_irq.h"
#include "altera_avalon_timer_regs.h"
#include "altera_avalon_timer.h"

// create standard embedded type definitions
typedef   signed char   sint8;              // signed 8 bit values
typedef unsigned char   uint8;              // unsigned 8 bit values
typedef   signed short  sint16;             // signed 16 bit values
typedef unsigned short  uint16;             // unsigned 16 bit values
typedef   signed long   sint32;             // signed 32 bit values
typedef unsigned long   uint32;             // unsigned 32 bit values
typedef         float   real32;             // 32 bit real values

//variables and arrays
uint32* timerPtr    = (uint32*)TIMER_0_BASE;
uint8* keyPtr = (uint8*)PUSHBUTTON_BASE;
unsigned char* ledPtr = (unsigned char*)LEDS_BASE;
uint8* hexPtr = (uint8*)HEX0_BASE;
uint8* swPtr = (uint8*)SWITCHES_BASE;
uint8* hexValues[10] = {0x40, 0xF9, 0x24, 0x30, 0x19, 0x12, 0x02, 0xF8, 0x00, 0x10}; // 7-segment display values for numbers 0-9
uint8 currentHexValue = 0; // variable to hold the current value of the LEDs
uint8 increase = 0; // variable to hold the current state of the switch (0 for increase, 1 for decrease)
uint8 decrease = 0;

void increaseHex(void);
void decreaseHex(void);


//interrupt on PB
void pushbutton_isr(void *context){
    if((*swPtr & 0x01) == 1){
        increase = 1;
    }
    else if ((*swPtr & 0x01) == 0){
        decrease = 1;
    }
    *(keyPtr + 12) = 1;
}

//interrupt on timer
void timer_isr(void *context){
    //clear flag
    *timerPtr = 0;

    *ledPtr ^= *ledPtr; //toggle leds
}

int main(void){
    *hexPtr = hexValues[currentHexValue]; //init to 0
    *ledPtr = 0; //init to 0
    alt_ic_isr_register(TIMER_0_IRQ_INTERRUPT_CONTROLLER_ID,TIMER_0_IRQ,timer_isr,0,0);
    alt_ic_isr_register(PUSHBUTTON_IRQ_INTERRUPT_CONTROLLER_ID,PUSHBUTTON_IRQ,pushbutton_isr,0,0);
    *(keyPtr + 8) = 1;
    while(1){
        if(increase == 1){
            increaseHex();
        }
        else if (decrease == 1){
            decreaseHex();
        }
    }
}

void increaseHex(void){
    if(currentHexValue == 9){
    	increase = 0;
        return;
    }
    else{
        currentHexValue++;
        *hexPtr = hexValues[currentHexValue];
        increase = 0;
        while((*keyPtr & 0x01) == 0);
    }
}

void decreaseHex(void){
    if(currentHexValue == 0){
    	decrease = 0;
        return;
    }
    else{
        currentHexValue--;
        *hexPtr = hexValues[currentHexValue];
        decrease = 0;
        while((*keyPtr & 0x01) == 0);

    }
}

