.text

# define a macro to move a 32 bit address to a register

.macro MOVIA reg, addr
  movhi \reg, %hi(\addr)
  ori \reg, \reg, %lo(\addr)
.endm


# def hex 0 and push buttons
.equ HEX0, 0x11010
.equ PUSHBUTTON, 0x11020
.equ SWITCH, 0x11000

# def hex values
.equ ZEROHEX, 0b1000000
.equ ONEHEX, 0b1111001
.equ TWOHEX, 0b0100100
.equ THREEHEX, 0b0110000
.equ FOURHEX, 0b0011001
.equ FIVEHEX, 0b0010010
.equ SIXHEX, 0b0000010
.equ SEVENHEX, 0b1111000
.equ EIGHTHEX, 0b0000000
.equ NINEHEX, 0b0010000

.global main

main:

# assign registers their respective addresses for future use.
 movia r2, HEX0
 movia r3, 0(PUSHBUTTON)
 movia r4, 0(SWITCH)

swdetect:
 bgt r4, r0, increment
 bet r4, r0, decrement

increment:
 bet r3, r0, decrement
 bgt r3, r0, increment
 call INCREASE
decrement:
 bgt r3, r0, increment
 bet r3, r0, decrement
 call DECREASE


 # subroutine for incrementing hex
INCREASE:
 bgt r3, r0, INCREASE

 # subroutine for decrementing hex
DECREASE:
 bgt r3, r0, DECREASE

